    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mind Blow listens to your breath through the microphone to inflate the tire. Audio is analyzed live and never recorded or stored."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mind Blow mendengarkan tiupanmu lewat mikrofon untuk memompa ban. Audio dianalisis langsung dan tidak pernah direkam atau disimpan."
          }
        }
      }
    }
  },
  "version" : "1.0"
